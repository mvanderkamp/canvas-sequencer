{
  "name": "canvas-sequencer",
  "version": "3.1.2",
  "description": "Store, serialize, parse, and execute sequences of canvas context instructions.",
  "author": "Michael van der Kamp <michael.vanderkamp@usask.ca>",
  "source": "src/entry.mjs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./dist": "./dist/index.js",
    "./dist/index": "./dist/index.js",
    "./dist/index.js": "./dist/index.js",
    "./index": "./index.js",
    "./index.js": "./index.js",
    "./src/*.js": "./src/*.js",
    "./src/*.mjs": "./src/*.mjs",
    "./src/*": "./src/*.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.mjs",
    "index.js",
    "src/",
    "index.d.ts"
  ],
  "targets": {
    "types": false,
    "main": {
      "optimize": true
    }
  },
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvanderkamp/canvas-sequencer.git"
  },
  "keywords": [
    "javascript",
    "canvas",
    "context",
    "sequence",
    "graphics",
    "CanvasRenderingContext2D",
    "art",
    "network",
    "socket",
    "transmit",
    "JSON",
    "serializable",
    "parse"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mvanderkamp/canvas-sequencer/issues"
  },
  "homepage": "https://mvanderkamp.github.io/canvas-sequencer/",
  "scripts": {
    "build": "parcel build --no-source-maps",
    "build:debug": "parcel build --no-optimize",
    "lint": "eslint index.js src tests",
    "lint:fix": "eslint index.js src tests --fix",
    "test": "jest",
    "test:types": "tsc --noEmit --strict --module Node16 --moduleResolution Node16 --target ES2022 --lib ES2022,DOM tests/types/consumer.ts",
    "test:coverage": "jest --coverage",
    "test:debug": "node inspect $(npm bin)/jest --runInBand"
  },
  "jest": {
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/tests/"
    ]
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "parcel": "^2.16.4",
    "typescript": "^5.9.3"
  }
}
